# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.key
*credentials*
*secret*

# ---- Large media (GitHub rejects files over 100 MB) ----
*.mp4
*.mov
*.avi
*.zip

# ---- Office lock / temp files ----
~$*
*.tmp
*.bak

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- Node ----
node_modules/
npm-debug.log*

# ---- Working files ----
old/
render/
_*

# ---- OS ----
Thumbs.db
desktop.ini
.DS_Store
